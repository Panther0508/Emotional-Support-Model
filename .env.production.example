# Production Environment Variables
# Copy this file to .env and fill in the values

# Required
SECRET_KEY=your-super-secret-key-here-generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Environment
FLASK_ENV=production

# Optional API Tokens (get from respective services)
# HF_TOKEN=your-huggingface-token-here
# GOOGLE_TOKEN=your-google-ai-token-here

# NLTK (optional, defaults to ./nltk_data)
# NLTK_DATA=/tmp/nltk_data

# Server (optional, Render sets this automatically)
# PORT=10000
